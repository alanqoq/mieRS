{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "blockedGroups": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "pattern": "^\\S+$"
      }
    },
    "maxQueue": {
      "type": "integer",
      "minimum": 1
    },
    "queueFullMessage": {
      "type": "string",
      "maxLength": 4000
    },
    "cooldownMinutes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "blockedGroups",
    "maxQueue",
    "queueFullMessage",
    "cooldownMinutes"
  ],
  "additionalProperties": false
}
